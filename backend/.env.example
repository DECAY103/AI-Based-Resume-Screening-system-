# Copy this file to .env and fill in real values before running the server.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=REPLACE_WITH_POSTGRESQL_URL

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── AI — Stage 2 (M.8) ───────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
STAGE2_TIMEOUT_SECONDS=60
STAGE2_MAX_RETRIES=2
STAGE2_BACKOFF_BASE_SECONDS=1.0

# ── Pipeline Config ────────────────────────────────────────────────────────────
STAGE1_TOP_N=10                 # number of candidates promoted from Stage 1 to Stage 2
STAGE1_SIMILARITY_THRESHOLD=0.0 # minimum cosine similarity required for Stage 2
MAX_PDF_SIZE_MB=5
MAX_ZIP_SIZE_MB=50
MAX_ZIP_UNCOMPRESSED_MB=250
