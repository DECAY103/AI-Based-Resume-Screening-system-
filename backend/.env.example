# Copy this file to .env and fill in real values before running the server.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/resume_screening

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
TEMP_TOKEN_EXPIRE_MINUTES=10
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# ── AI — Stage 2 (M.8) ───────────────────────────────────────────────────────
# Required only when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=heuristic

# ── Pipeline Config ────────────────────────────────────────────────────────────
STAGE1_TOP_N=10                 # number of candidates promoted from Stage 1 to Stage 2
MAX_PDF_SIZE_MB=5
MAX_ZIP_SIZE_MB=50
MAX_ZIP_UNCOMPRESSED_MB=250
MIN_SIMILARITY_SCORE=-1
