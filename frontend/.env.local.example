# Copy this file to .env.local and fill in the values before starting the dev server.

# URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must be IDENTICAL to JWT_SECRET in backend/.env. The Next.js middleware uses it
# to verify the login cookie. Server-side only (no NEXT_PUBLIC_ prefix), so it is
# never sent to the browser.
JWT_SECRET=paste-the-same-value-as-backend-env
